{
  "name": "skilltrace-ai",
  "private": true,
  "version": "0.1.0",
  "description": "SkillTrace AI - the evidence-backed Skill Passport (Google #BuildHybridAI 2026)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @skilltrace/web dev",
    "build": "pnpm --filter @skilltrace/web build && pnpm --filter @skilltrace/extension build",
    "build:web": "pnpm --filter @skilltrace/web build",
    "build:extension": "pnpm --filter @skilltrace/extension build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-skilltrace \"npx vitest run --config tests/rules/vitest.config.ts\"",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:env": "node scripts/check-env.mjs",
    "setup:firebase": "node scripts/setup-firebase-env.mjs",
    "media:generate": "node scripts/generate-lab-media.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:secrets"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "^6.2.8",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.37.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "mediabunny": "1.66.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}

# Copy to apps/web/.env.local and fill in from Firebase console > Project settings > Your apps (Web).
# These web config values are not secrets, but keep real values out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic). recaptcha-v3 (free) or recaptcha-enterprise.
VITE_APPCHECK_PROVIDER=recaptcha-v3
VITE_RECAPTCHA_SITE_KEY=
# Local development only: prints an App Check debug token to the console to register in the Firebase console.
VITE_APPCHECK_DEBUG=true
# Optional: a debug token you generated in Firebase console > App Check > Apps > Manage debug tokens.
# Without it the SDK prints a new token to the browser console for you to register.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: override the cloud fallback model (default: SDK default gemini-3.5-flash-lite).
VITE_AI_CLOUD_MODEL=
# Optional: use the Firebase Emulator Suite (auth 9099, firestore 8085).
VITE_USE_EMULATORS=false
# Optional: pre-fill the Chrome extension ID for dashboard <-> extension sync.
VITE_EXTENSION_ID=
